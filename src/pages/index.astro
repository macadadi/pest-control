---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaStrip from '../components/CtaStrip.astro';
import { business, siteName } from '../site';
import { getCollection } from 'astro:content';

const pestsAll = await getCollection('pests');
const pests = pestsAll.sort(
  (a, b) => (a.data.order ?? 999) - (b.data.order ?? 999)
);

const svcAll = await getCollection('services');
const services = svcAll.sort(
  (a, b) => (a.data.order ?? 999) - (b.data.order ?? 999)
);

const citiesAll = await getCollection('cities');
const cities = citiesAll.sort(
  (a, b) => (a.data.order ?? 999) - (b.data.order ?? 999)
);

const postsAll = await getCollection('blog');
const posts = postsAll.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
).slice(0, 4);

const teaser = (s: string, n: number) =>
  s.length <= n ? s : s.slice(0, n).trimEnd().replace(/\s+\S*$/, '') + '…';
---

<BaseLayout
  title={`${siteName} | Reliable Pest Control & Fumigation Kenya`}
  description="Professional pest control Kenya, Nairobi, Mombasa, Kisumu, Nakuru, Eldoret, and countrywide. Termites, bed bugs, rodents, cockroaches, fumigation, mosquitoes, and integrated pest management for homes, hotels, warehouses, farms, and food plants."
  path="/"
  ogImage="/images/home/hero-technician.png"
>
  <section class="hero">
    <div class="container hero-stacked">
      <div class="hero-row hero-row--image-end">
        <div class="hero-row-copy">
          <h1 class="hero-title">
            Reliable pest control services built for Kenyan homes, businesses, and industry
          </h1>
          <p class="lead">
            From apartments and estates to hotels, cold stores, milling lines, and export pack houses: We do inspection led
            treatments and documented programmes for termites, bed bugs, rodents, cockroaches, fumigation,
            mosquitoes, and ongoing IPM when you need a crew that plans for how your site actually runs.
          </p>
        </div>
        <div class="hero-row-media">
          <img
            src="/images/home/hero-technician.png"
            alt="Kenya Pest Control technician in protective gear treating vegetation with a backpack mist blower"
            width="1024"
            height="768"
            loading="eager"
            decoding="async"
          />
        </div>
      </div>
      <div class="hero-row">
        <div class="hero-row-media">
          <img
            src="/images/home/hero-branded-vehicle.png"
            alt="Kenya Pest Control branded service vehicle with contact details and service list"
            width="1024"
            height="768"
            loading="eager"
            decoding="async"
          />
        </div>
        <div class="hero-row-copy">
          <h2 class="hero-why-heading">Why choose us</h2>
          <ul class="hero-highlights">
            <li>Clear preparation, realistic re-entry times, and audit-friendly paperwork when required</li>
            <li>Scoping from photos or on-site visits so programmes match access and operations</li>
            <li>Nationwide mobilisation from a Nairobi operations base</li>
          </ul>
          <div class="hero-trust" role="note">
            <a href={`tel:${business.phoneTel}`}>Call {business.phoneDisplay}</a>
            <span class="hero-trust-sep" aria-hidden="true">·</span>
            <span>{business.openingHours}</span>
            <span class="hero-trust-sep" aria-hidden="true">·</span>
            <a href="/contact/#quote">Email a brief</a>
          </div>
          <div class="actions">
            <a class="btn btn-primary" href="/contact/#quote">Get a quote</a>
            <a class="btn btn-ghost" href="/contact/#inspection">Request inspection</a>
            <a class="btn btn-ghost" href="/pests/">Browse pests</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>Why we start from your site, not a generic checklist</h2>
      <p>
        Kenya’s rainfall patterns, coastal humidity, lakeside conditions, and highland temperature swings all change
        how pests behave and how treatments perform. The same pest in Nairobi may need a different programme than on
        the coast or in the Rift, so we scope every job from inspection and access, not assumptions.
      </p>
      <p>
        Households and facilities teams often want the same things up front: clear preparation, realistic re-entry
        times, paperwork for auditors, and programmes that match how the building actually runs. We have spelled out
        those topics in detail in our{' '}
        <a href="/faq/#climate-pests-kenya">FAQ</a>, start there, then{' '}
        <a href="/contact/#quote">get a quote</a> or <a href="/contact/#inspection">request an inspection</a> when you
        are ready.
      </p>
      <p>
        Explore <a href="/pests/">pest guides</a>, <a href="/services/">services</a>, and{' '}
        <a href="/locations/">service areas</a> for Nairobi, Mombasa, Kisumu, Nakuru, and nationwide routes.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>Our services</h2>
        <p>
          Fumigation, inspections, residential and commercial programmes, mosquito and vector work, contracts, training,
          and export-related treatments, scoped honestly to your site and compliance needs.
        </p>
      </div>
      <div class="cards">
        {
          services.map((s) => (
            <article class:list={['card', s.data.coverImage && 'card--media']}>
              {s.data.coverImage && s.data.coverAlt && (
                <div class="card-thumb">
                  <a href={`/services/${s.id}/`}>
                    <img
                      src={s.data.coverImage}
                      alt={s.data.coverAlt}
                      width="400"
                      height="250"
                      loading="lazy"
                      decoding="async"
                    />
                  </a>
                </div>
              )}
              <div class="card-body">
                <h3>{s.data.title}</h3>
                <p class="meta-muted">{teaser(s.data.description, 120)}</p>
                <a class="card-link" href={`/services/${s.id}/`}>Service details</a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>Service areas across Kenya</h2>
        <p>
          We routinely serve Nairobi, Mombasa, Kisumu, and Nakuru, and regularly schedule work in Eldoret, Machakos,
          Kiambu, Embu, Nyeri, Meru, and other counties, contact us with your location for capital-region programmes, coast hospitality
          support, lakeside sites, or nationwide fumigation and contract routes.
        </p>
      </div>
      <div class="cards">
        {
          cities.map((c) => (
            <article class:list={['card', c.data.coverImage && 'card--media']}>
              {c.data.coverImage && c.data.coverAlt && (
                <div class="card-thumb">
                  <a href={`/locations/${c.id}/`}>
                    <img
                      src={c.data.coverImage}
                      alt={c.data.coverAlt}
                      width="400"
                      height="250"
                      loading="lazy"
                      decoding="async"
                    />
                  </a>
                </div>
              )}
              <div class="card-body">
                <h3>{c.data.title}</h3>
                <p class="meta-muted">{teaser(c.data.description, 120)}</p>
                <a class="card-link" href={`/locations/${c.id}/`}>{c.data.title} overview</a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>Pest control guides</h2>
        <p>Short articles on termites, monsoon cockroach pressure, export fumigation readiness, and other Kenya specific topics.</p>
      </div>
      <ul class="prose">
        {
          posts.map((post) => (
            <li>
              <a href={`/blog/${post.id}/`}>{post.data.title}</a>
              <span class="meta-muted">: {teaser(post.data.description, 88)}</span>
            </li>
          ))
        }
      </ul>
      <p><a href="/blog/">All guides</a></p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>Common pests in Kenya</h2>
        <p>
          Practical guides on identification, risk, and treatment, written for Kenyan buildings and seasons, not generic
          overseas checklists.
        </p>
      </div>
      <div class="cards">
        {
          pests.slice(0, 12).map((p) => (
            <article class:list={['card', p.data.coverImage && 'card--media']}>
              {p.data.coverImage && p.data.coverAlt && (
                <div class="card-thumb">
                  <a href={`/pests/${p.id}/`}>
                    <img
                      src={p.data.coverImage}
                      alt={p.data.coverAlt}
                      width="400"
                      height="250"
                      loading="lazy"
                      decoding="async"
                    />
                  </a>
                </div>
              )}
              <div class="card-body">
                <h3>{p.data.title}</h3>
                <p class="meta-muted">{teaser(p.data.description, 110)}</p>
                <a class="card-link" href={`/pests/${p.id}/`}>View {p.data.title.toLowerCase()} guide</a>
              </div>
            </article>
          ))
        }
      </div>
      <p style="margin-top:1rem">
        <a href="/pests/">View all {pests.length} pest guides</a>
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <CtaStrip />
    </div>
  </section>
</BaseLayout>
